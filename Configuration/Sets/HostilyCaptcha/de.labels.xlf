<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" target-language="de" datatype="plaintext" original="EXT:hostily_captcha/Configuration/Sets/HostilyCaptcha/labels.xlf" product-name="hostily_captcha">
		<body>
			<trans-unit id="settings.hostilyCaptcha.siteKey.label">
				<source>Site key</source>
				<target>Site-Key</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.siteKey.description">
				<source>Overrides the global extension setting for this site. Empty = global setting.</source>
				<target>Überschreibt die globale Extension-Einstellung für diese Site. Leer = globale Einstellung.</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.secret.label">
				<source>Secret</source>
				<target>Secret</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.secret.description">
				<source>Secret key of the project (only used on the server). Empty = global setting.</source>
				<target>Geheimer Schlüssel des Projekts (nur auf dem Server benutzt). Leer = globale Einstellung.</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.serviceUrl.label">
				<source>Service URL</source>
				<target>Dienst-URL</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.serviceUrl.description">
				<source>Empty = global setting (default https://captcha.hostily.de).</source>
				<target>Leer = globale Einstellung (Vorgabe https://captcha.hostily.de).</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.label">
				<source>Mode</source>
				<target>Modus („Gedrückt halten“ und „Schieberegler“ bieten immer die Alternative „Per Klick bestätigen“)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.language.label">
				<source>Widget language</source>
				<target>Sprache des Widgets</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.onError.label">
				<source>If the service fails</source>
				<target>Bei Ausfall des Dienstes</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.global">
				<source>(global setting)</source>
				<target>(globale Einstellung)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.sichtbar">
				<source>Visible (checkbox)</source>
				<target>Sichtbar (Kästchen)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.unsichtbar">
				<source>Invisible (solves on submit)</source>
				<target>Unsichtbar (löst beim Absenden)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.language.auto">
				<source>Automatic (language of the page)</source>
				<target>Automatisch (Sprache der Seite)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.onError.allow">
				<source>let the visitor through</source>
				<target>durchlassen</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.onError.block">
				<source>block the submission</source>
				<target>blockieren</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.portal" approved="yes">
				<source>As in the customer portal (project setting)</source>
				<target>Wie im Kundenportal (Einstellung des Projekts)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.halten" approved="yes">
				<source>Press and hold</source>
				<target>Gedrückt halten</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.mode.schieben" approved="yes">
				<source>Slider</source>
				<target>Schieberegler</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.holdTime.label" approved="yes">
				<source>Hold time (ms)</source>
				<target>Haltezeit (ms)</target>
			</trans-unit>
			<trans-unit id="settings.hostilyCaptcha.holdTime.description" approved="yes">
				<source>800-3000, only for press and hold. Empty = global setting.</source>
				<target>800–3000, nur für „Gedrückt halten“. Leer = globale Einstellung.</target>
			</trans-unit>
		</body>
	</file>
</xliff>
